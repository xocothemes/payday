---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/ui/Icon.astro";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  label: string;
  /** `light` for dark backgrounds. */
  tone?: "dark" | "light";
  size?: "md" | "sm";
}

const { label, tone = "dark", size = "md", class: className, ...attrs } = Astro.props;
---

<a {...attrs} class:list={["btn-cta", tone === "light" && "btn-cta-light", size === "sm" && "btn-cta-sm", className]}>
  {label}
  <span class="btn-cta-icon"><Icon name="arrow-right" class="size-4" stroke={2} /></span>
</a>
