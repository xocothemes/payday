---
interface Props {
  id: string;
  title: string;
  /** A second, muted line in the same heading. */
  subtitle?: string;
  class?: string;
}

const { id, title, subtitle, class: className } = Astro.props;
---

<h2 id={id} class:list={["reveal max-w-3xl text-display-md", className]}>
  {title}
  {subtitle && <span class="block text-muted">{subtitle}</span>}
</h2>
