---
interface Props {
  title: string;
  lead?: string;
  /** Extra room at the bottom for content that overlaps the band. */
  overlap?: boolean;
}

const { title, lead, overlap = false } = Astro.props;
---

<section
  class:list={[
    "dusk grain relative isolate overflow-hidden pt-[calc(var(--header-h)+clamp(3.5rem,7vw,6rem))]",
    overlap ? "pb-[clamp(9rem,18vw,15rem)]" : "pb-[clamp(4rem,8vw,6.5rem)]",
  ]}
>
  <div class="shell relative z-10">
    <h1 class="rise max-w-3xl text-display-xl">{title}</h1>
    {lead && <p class="rise mt-6 max-w-xl text-lead text-white/80" style="--i:1">{lead}</p>}
  </div>
</section>
