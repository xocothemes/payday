---
/* Three compliance seals in one muted ink, each in its own style. */
const star = (cx: number, cy: number, outer: number, inner: number) =>
  Array.from({ length: 10 }, (_, i) => {
    const r = i % 2 ? inner : outer;
    const a = (Math.PI / 5) * i - Math.PI / 2;
    return `${(cx + r * Math.cos(a)).toFixed(2)},${(cy + r * Math.sin(a)).toFixed(2)}`;
  }).join(" ");
const ring = Array.from({ length: 12 }, (_, i) => (Math.PI / 6) * i - Math.PI / 2);
---

<ul class="seals flex flex-wrap gap-3 sm:gap-4">
  <li>
    <svg viewBox="0 0 100 100" class="seal" role="img" aria-label="AICPA SOC 2">
      <circle cx="50" cy="50" r="48" class="disc" />
      <circle cx="50" cy="50" r="41" fill="none" stroke="currentColor" stroke-opacity="0.25" stroke-dasharray="1.5 2.5" />
      <text x="50" y="47" text-anchor="middle" font-size="13" font-weight="700" letter-spacing="0.5">AICPA</text>
      <text x="50" y="63" text-anchor="middle" font-size="13" font-weight="700" letter-spacing="0.5">SOC2</text>
    </svg>
  </li>
  <li>
    <svg viewBox="0 0 100 100" class="seal" role="img" aria-label="GDPR">
      <circle cx="50" cy="50" r="48" class="disc" />
      {ring.map((a) => <polygon points={star(50 + 33 * Math.cos(a), 50 + 33 * Math.sin(a), 3.6, 1.5)} />)}
      <text x="50" y="55" text-anchor="middle" font-size="13" font-weight="700" letter-spacing="0.3">GDPR</text>
    </svg>
  </li>
  <li>
    <svg viewBox="0 0 100 100" class="seal" role="img" aria-label="ISO/IEC 27001 certified">
      <circle cx="50" cy="50" r="48" class="disc" />
      <path d="M50 17 75 26v20c0 17-10.5 28-25 34-14.5-6-25-17-25-34V26z" fill="none" stroke="currentColor" stroke-width="1.6" />
      <path d="M50 21.5 71 29v17c0 14.5-8.8 24-21 29.3C37.8 70 29 60.5 29 46V29z" fill="none" stroke="currentColor" stroke-width="0.7" stroke-opacity="0.6" />
      {[38, 50, 62].map((x, i) => <polygon points={star(x, i === 1 ? 31 : 33, 2.6, 1.1)} />)}
      <text x="50" y="47" text-anchor="middle" font-size="6.6" font-weight="700" letter-spacing="0.2">ISO/IEC</text>
      <text x="50" y="57.5" text-anchor="middle" font-size="10.5" font-weight="700">27001</text>
      <path d="M22 62h56l-4 4.5 4 4.5H22l4-4.5z" class="ribbon" />
      <text x="50" y="68.6" text-anchor="middle" font-size="4.6" font-weight="700" letter-spacing="0.9" class="ribbon-text">CERTIFIED</text>
    </svg>
  </li>
</ul>

<style>
  .seal {
    width: clamp(5.5rem, 4.5rem + 3vw, 7rem);
    height: auto;
    color: var(--muted);
    fill: currentColor;
  }

  .disc {
    fill: var(--surface);
    stroke: var(--line-strong);
  }

  .ribbon {
    fill: var(--muted);
  }

  .ribbon-text {
    fill: var(--surface);
  }
</style>
