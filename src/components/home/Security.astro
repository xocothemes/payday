---
import Seals from "@/components/home/Seals.astro";
import Icon from "@/components/ui/Icon.astro";
import { security } from "@/config/home";
---

<section id="security" class="bg-wash section" aria-labelledby="security-title">
  <div class="shell grid items-center gap-12 md:grid-cols-[1fr_auto] md:gap-16">
    <div class="reveal">
      <h2 id="security-title" class="text-display-md">{security.title}</h2>
      <p class="mt-4 max-w-lg text-lead text-muted">{security.body}</p>
      <ul class="mt-8 grid max-w-md grid-cols-2 gap-x-6 gap-y-3 text-[0.9375rem]">
        {
          security.points.map((point) => (
            <li class="flex items-center gap-2.5">
              <Icon name="shield-check" class="size-4 text-accent" />
              {point}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="reveal" style="--i:1">
      <Seals />
    </div>
  </div>
</section>
