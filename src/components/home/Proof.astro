---
import { Image } from "astro:assets";
import { quote, stats } from "@/config/home";
---

<section class="shell section" aria-label="Results">
  <dl class="grid grid-cols-3 gap-6 border-b border-line pb-14 sm:pb-20">
    {
      stats.map((stat, index) => (
        <div class="reveal flex flex-col-reverse" style={`--i:${index}`}>
          <dt class="mt-3 text-sm text-ink-soft">{stat.label}</dt>
          <dd class="text-[clamp(2.4rem,1.4rem+4.4vw,5rem)] leading-none tracking-[-0.06em] tabular">{stat.value}</dd>
        </div>
      ))
    }
  </dl>

  <figure class="reveal mt-14 grid overflow-hidden rounded-(--radius-card) bg-wash sm:mt-20 md:grid-cols-[1.5fr_1fr]">
    <div class="flex flex-col justify-between gap-12 p-8 sm:p-12">
      <blockquote class="text-[clamp(1.35rem,1.1rem+0.9vw,1.75rem)] leading-snug tracking-[-0.03em]">“{quote.text}”</blockquote>
      <figcaption class="text-sm">
        <span class="block font-medium">{quote.name}</span>
        <span class="text-muted">{quote.role}</span>
      </figcaption>
    </div>
    <Image src={quote.photo} alt={quote.name} widths={[480, 720, 960]} sizes="(min-width: 48rem) 26rem, 100vw" class="aspect-4/3 size-full object-cover object-[50%_18%] md:aspect-auto" />
  </figure>
</section>
