---
import Icon from "@/components/ui/Icon.astro";
import { faq } from "@/config/home";
---

<section id="faq" class="shell section grid pt-0 gap-10 md:grid-cols-[1fr_2fr] md:gap-16" aria-labelledby="faq-title">
  <h2 id="faq-title" class="reveal text-display-md">{faq.title}</h2>
  <div class="reveal divide-y divide-line border-y border-line">
    {
      faq.items.map((item) => (
        <details class="qa group" name="faq">
          <summary class="flex items-center justify-between gap-6 py-5 text-[1.0625rem] tracking-[-0.02em]">
            {item.question}
            <span class="grid size-7 shrink-0 place-items-center rounded-full bg-wash transition-transform duration-300 group-open:rotate-45">
              <Icon name="plus" class="size-3.5" stroke={2} />
            </span>
          </summary>
          <p class="max-w-xl pb-6 text-ink-soft">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .qa summary {
    list-style: none;
  }

  .qa summary::-webkit-details-marker {
    display: none;
  }

  .qa[open] p {
    animation: rise 0.5s var(--ease-out-expo);
  }
</style>
