---
import CountryTable from "@/components/product/CountryTable.astro";
import { global } from "@/config/home";
---

<section id="global" class="dawn grain grain-light relative isolate overflow-hidden px-(--gutter) py-20 sm:py-28 lg:py-32" aria-labelledby="global-title">
  <div class="reveal relative z-10 mx-auto max-w-4xl rounded-[1.5rem] bg-surface p-6 sm:p-10">
    <h2 id="global-title" class="max-w-xl text-[clamp(1.6rem,1.3rem+1vw,2.2rem)] leading-tight tracking-[-0.035em]">
      {global.title}
      <span class="block text-muted">{global.body}</span>
    </h2>
    <div class="mt-8">
      <CountryTable />
    </div>
  </div>
</section>
