---
import Benefits from "@/components/product/Benefits.astro";
import PayRun from "@/components/product/PayRun.astro";
import Taxes from "@/components/product/Taxes.astro";
import TimeOff from "@/components/product/TimeOff.astro";
import Icon from "@/components/ui/Icon.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { product } from "@/config/home";

const panels = [PayRun, Taxes, TimeOff, Benefits];
---

<section id="product" class="shell section" aria-labelledby="product-title">
  <SectionTitle id="product-title" title={product.title} subtitle={product.subtitle} />

  <div class="mt-12 grid items-start gap-8 md:grid-cols-2 md:gap-14" data-tabs>
    <div class="reveal grid gap-1" role="tablist" aria-label={product.title} aria-orientation="vertical">
      {
        product.tabs.map((tab, index) => (
          <button
            type="button"
            id={`product-tab-${index}`}
            class="tab rounded-xl px-4 py-3.5 text-left"
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`product-panel-${index}`}
            tabindex={index === 0 ? 0 : -1}
            data-tab
          >
            <span class="flex items-center gap-3 text-[1.0625rem] tracking-[-0.02em]">
              <Icon name={tab.icon} class="size-5" stroke={1.5} />
              {tab.title}
            </span>
            <span class="tab-body block pt-2 pl-8 text-[0.9375rem] text-ink-soft">{tab.body}</span>
          </button>
        ))
      }
    </div>

    <div class="reveal grain relative grid aspect-square place-items-center overflow-hidden rounded-(--radius-card) bg-card p-6 sm:aspect-5/4" style="--i:1">
      {
        panels.map((Panel, index) => (
          <div
            id={`product-panel-${index}`}
            class="panel relative z-10 grid w-full place-items-center [grid-area:1/1]"
            role="tabpanel"
            aria-labelledby={`product-tab-${index}`}
            data-panel
            data-active={index === 0 ? "" : undefined}
            inert={index !== 0}
          >
            <Panel />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tab {
    transition: background-color 0.25s;
  }

  .tab[aria-selected="true"] {
    background: var(--card);
  }

  .tab[aria-selected="false"]:hover {
    background: var(--wash);
  }

  .tab-body {
    display: none;
  }

  .tab[aria-selected="true"] .tab-body {
    display: block;
    animation: rise 0.5s var(--ease-out-expo);
  }

  .panel {
    opacity: 0;
    transform: translateY(0.75rem) scale(0.98);
    transition:
      opacity 0.35s,
      transform 0.6s var(--ease-out-expo);
  }

  .panel[data-active] {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  import { initTabs } from "@/scripts/tabs";
  initTabs();
</script>
