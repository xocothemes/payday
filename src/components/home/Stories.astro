---
import CompanyLogo from "@/components/ui/CompanyLogo.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { stories } from "@/config/home";

const tones = {
  dusk: "linear-gradient(165deg, #1f1850 0%, #4b3487 45%, #9a6aa8 75%, #f0a385 100%)",
  sea: "linear-gradient(165deg, #0d2740 0%, #1f5a7d 45%, #4f97a8 75%, #b9ded4 100%)",
  ember: "linear-gradient(165deg, #2a1424 0%, #6e2b3d 45%, #b85a4c 75%, #f3bd7d 100%)",
};
---

<section class="shell section pt-0" aria-labelledby="stories-title">
  <SectionTitle id="stories-title" title={stories.title} subtitle={stories.subtitle} />
  <ul class="mt-12 grid gap-4 md:grid-cols-3">
    {
      stories.items.map((story, index) => (
        <li class="reveal" style={`--i:${index}`}>
          <div class="grain relative isolate grid aspect-4/3 place-items-center overflow-hidden rounded-(--radius-card) text-white">
            <span class="absolute inset-0 -z-10" style={`background:${tones[story.tone]}`} />
            <CompanyLogo name={story.company} class="relative z-10 text-2xl" />
          </div>
          <p class="mt-5 text-3xl tracking-[-0.05em] tabular">{story.metric}</p>
          <p class="mt-1 text-ink-soft">{story.text}</p>
        </li>
      ))
    }
  </ul>
</section>
