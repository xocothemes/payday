---
import CtaButton from "@/components/ui/CtaButton.astro";
import { closing } from "@/config/home";
import { siteConfig } from "@/config/site";
---

<section class="dusk grain relative isolate overflow-hidden px-(--gutter) py-28 text-center text-white sm:py-40" aria-labelledby="closing-title">
  <h2 id="closing-title" class="reveal relative z-10 mx-auto max-w-2xl text-display-lg">{closing.title}</h2>
  <CtaButton href={siteConfig.cta.href} label={siteConfig.cta.label} tone="light" class="reveal relative z-10 mt-9" style="--i:1" />
</section>
