---
import Avatar from "@/components/product/Avatar.astro";
import AppIcon from "@/components/ui/AppIcon.astro";
import Icon from "@/components/ui/Icon.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { bento } from "@/config/home";
import { integrations } from "@/config/integrations";

const costs = [
  { code: "US", value: 96, amount: "$96K" },
  { code: "PT", value: 38, amount: "$41K" },
  { code: "NO", value: 32, amount: "$32K" },
  { code: "ZA", value: 16, amount: "$16K" },
  { code: "JP", value: 15, amount: "$12K" },
];
const columns = 3;
const lastRowStart = bento.cards.length - (bento.cards.length % columns || columns);
---

<section class="shell section" aria-labelledby="bento-title">
  <SectionTitle id="bento-title" title={bento.title} subtitle={bento.subtitle} />

  <ul class="mt-12 grid overflow-hidden rounded-(--radius-card) border border-line md:grid-cols-3">
    {
      bento.cards.map((card, index) => (
        <li
          class:list={[
            "reveal flex flex-col gap-8 border-line p-6 sm:p-7",
            index < bento.cards.length - 1 && "border-b",
            index >= lastRowStart && "md:border-b-0",
            index % columns !== columns - 1 && "md:border-r",
          ]}
          style={`--i:${index % columns}`}
        >
          <div>
            <h3 class="font-medium tracking-[-0.02em]">{card.title}</h3>
            <p class="mt-1 text-[0.9375rem] text-muted">{card.body}</p>
          </div>

          <div class="mt-auto flex min-h-60 flex-col justify-center rounded-xl bg-wash p-4 text-[0.8125rem]" aria-hidden="true">
            {card.id === "payslips" && (
              <div class="rounded-lg bg-surface p-4 ring-1 ring-line">
                <div class="flex items-center justify-between">
                  <span class="flex items-center gap-2">
                    <Avatar name="Ingrid Solberg" class="size-6 text-[0.5rem]" />
                    <span class="font-medium">Ingrid Solberg</span>
                  </span>
                  <span class="mono-label text-muted">NOV</span>
                </div>
                <dl class="mt-3 grid gap-1.5">
                  <div class="flex justify-between"><dt class="text-ink-soft">Gross pay</dt><dd class="tabular">kr 58,400</dd></div>
                  <div class="flex justify-between"><dt class="text-ink-soft">Tax and pension</dt><dd class="tabular">− kr 20,440</dd></div>
                  <div class="flex justify-between border-t border-line pt-1.5 font-medium"><dt>Net pay</dt><dd class="tabular">kr 37,960</dd></div>
                </dl>
              </div>
            )}

            {card.id === "contractors" && (
              <div class="grid gap-2">
                {[
                  { name: "Noor Haddad", from: "$3,200", to: "AED 11,750" },
                  { name: "Lars Eriksen", from: "$2,400", to: "kr 26,180" },
                  { name: "Ayumi Sato", from: "$1,800", to: "¥271,600" },
                ].map((row) => (
                  <div class="flex items-center gap-2.5 rounded-lg bg-surface px-3 py-2.5 ring-1 ring-line">
                    <Avatar name={row.name} class="size-6 text-[0.5rem]" />
                    <span class="min-w-0 flex-1 truncate">{row.name.split(" ")[0]}</span>
                    <span class="text-muted tabular">{row.from}</span>
                    <Icon name="arrow-right" class="size-3 text-muted" />
                    <span class="tabular">{row.to}</span>
                  </div>
                ))}
              </div>
            )}

            {card.id === "onboarding" && (
              <div class="rounded-lg bg-surface p-4 ring-1 ring-line">
                <div class="flex items-center justify-between">
                  <span class="flex items-center gap-2">
                    <Avatar name="Dana Whitfield" class="size-6 text-[0.5rem]" />
                    <span class="font-medium">Dana Whitfield</span>
                  </span>
                  <span class="text-muted tabular">3 of 4</span>
                </div>
                <span class="mt-3 block h-1 overflow-hidden rounded-full bg-wash">
                  <span class="block h-full w-3/4 rounded-full bg-ink" />
                </span>
                <ul class="mt-3 grid gap-1.5">
                  {[
                    { label: "Contract signed", done: true },
                    { label: "Bank details", done: true },
                    { label: "Tax form", done: true },
                    { label: "Laptop shipped" },
                  ].map((step) => (
                    <li class="flex items-center gap-2">
                      <span class:list={["grid size-4 place-items-center rounded-full", step.done ? "bg-ink text-white" : "ring-1 ring-line-strong ring-inset"]}>
                        {step.done && <Icon name="check" class="size-2.5" stroke={3} />}
                      </span>
                      <span class:list={[!step.done && "text-muted"]}>{step.label}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {card.id === "expenses" && (
              <div class="grid gap-2">
                {[
                  { name: "Client dinner", amount: "$184.20", done: true },
                  { name: "Train to Porto", amount: "€62.40", done: true },
                  { name: "Monitor", amount: "$329.00" },
                ].map((expense) => (
                  <div class="flex items-center gap-2.5 rounded-lg bg-surface px-3 py-2.5 ring-1 ring-line">
                    <Icon name="receipt" class="size-4 text-muted" />
                    <span class="min-w-0 flex-1 truncate">{expense.name}</span>
                    <span class="tabular">{expense.amount}</span>
                    <span class:list={["size-1.5 rounded-full", expense.done ? "bg-up" : "bg-warn"]} />
                  </div>
                ))}
              </div>
            )}

            {card.id === "reports" && (
              <div class="rounded-lg bg-surface p-4 ring-1 ring-line">
                <p class="flex items-baseline justify-between">
                  <span class="text-muted">By country</span>
                  <span class="text-base tracking-[-0.03em] tabular">$197K</span>
                </p>
                <ul class="mt-3 grid gap-1.5">
                  {costs.map((row, i) => (
                    <li class="grid grid-cols-[1.5rem_1fr_2.5rem] items-center gap-2">
                      <span class="mono-label text-muted">{row.code}</span>
                      <span class="h-2 rounded-full bg-wash">
                        <span class:list={["block h-full rounded-full", i === 0 ? "bg-accent" : "bg-ink/20"]} style={`width:${row.value}%`} />
                      </span>
                      <span class="text-right text-muted tabular">{row.amount}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {card.id === "integrations" && (
              <ul class="grid gap-1.5">
                {integrations.map((item) => (
                  <li class="flex items-center gap-2.5 rounded-lg bg-surface px-3 py-2 ring-1 ring-line">
                    <AppIcon name={item.icon} class="size-5" bare />
                    <span class="min-w-0 flex-1 truncate">{item.name}</span>
                    <span class="text-[0.6875rem] text-up">Connected</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</section>
