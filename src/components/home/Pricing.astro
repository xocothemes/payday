---
import Icon from "@/components/ui/Icon.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { pricing } from "@/config/home";
---

<section id="pricing" class="pricing shell section pt-0" aria-labelledby="pricing-title">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <SectionTitle id="pricing-title" title={pricing.title} subtitle={pricing.subtitle} />
    <fieldset class="reveal flex rounded-full bg-wash p-1 text-sm shadow-[inset_0_0_0_1px_var(--line)]">
      <legend class="sr-only">Billing period</legend>
      <label class="period rounded-full px-4 py-1.5">
        <input type="radio" name="billing" value="monthly" class="sr-only" />
        Monthly
      </label>
      <label class="period rounded-full px-4 py-1.5">
        <input type="radio" name="billing" value="yearly" class="sr-only" checked />
        Yearly <span class="text-accent">−20%</span>
      </label>
    </fieldset>
  </div>

  <ul class="mt-12 grid gap-4 lg:grid-cols-3">
    {
      pricing.plans.map((plan, index) => (
        <li
          class:list={["reveal flex flex-col rounded-(--radius-card) p-7 sm:p-8", plan.featured ? "on-night grain relative isolate overflow-hidden" : "ring-1 ring-line ring-inset"]}
          style={`--i:${index}`}
        >
          <div class="relative z-10 flex flex-1 flex-col">
            <h3 class="text-lg font-medium tracking-[-0.02em]">{plan.name}</h3>
            <p class="mt-1 text-[0.9375rem] text-muted">{plan.body}</p>
            <p class="mt-8 flex items-baseline gap-2">
              {plan.monthly === null ? (
                <span class="text-5xl tracking-[-0.05em]">Custom</span>
              ) : (
                <>
                  <span class="text-5xl tracking-[-0.05em] tabular">
                    <span data-period="monthly">${plan.monthly}</span>
                    <span data-period="yearly">${plan.yearly}</span>
                  </span>
                  <span class="text-sm text-muted">per person a month</span>
                </>
              )}
            </p>
            <ul class="mt-8 grid gap-3 text-[0.9375rem]">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2.5">
                  <Icon name="check" class:list={["mt-1 size-4", plan.featured ? "text-[#b9aef5]" : "text-accent"]} stroke={2.25} />
                  {feature}
                </li>
              ))}
            </ul>
            <a href={plan.cta.href} class:list={["btn mt-10 w-full", plan.featured ? "bg-white text-ink" : "btn-primary"]}>
              {plan.cta.label}
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .period {
    transition:
      background-color 0.2s,
      box-shadow 0.2s;
  }

  .period:has(input:checked) {
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .period:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .pricing:has(input[value="monthly"]:checked) [data-period="yearly"],
  .pricing:has(input[value="yearly"]:checked) [data-period="monthly"] {
    display: none;
  }
</style>
