---
import PayrollWindow from "@/components/product/PayrollWindow.astro";
import CtaButton from "@/components/ui/CtaButton.astro";
import { hero } from "@/config/home";
import { siteConfig } from "@/config/site";
---

<section class="dusk grain relative isolate overflow-hidden pt-[calc(var(--header-h)+clamp(4rem,9vw,7.5rem))] pb-[clamp(12rem,26vw,22rem)] text-white">
  <div class="shell relative z-10">
    <div class="max-w-2xl">
      <h1 class="rise text-display-xl">{hero.title}</h1>
      <p class="rise mt-5 max-w-lg text-lead text-white/80" style="--i:1">{hero.lead}</p>
      <CtaButton href={siteConfig.cta.href} label={siteConfig.cta.label} tone="light" class="rise mt-9" style="--i:2" />
    </div>
  </div>
</section>

<div class="shell relative z-10 -mt-[clamp(9rem,20vw,17rem)]">
  <div class="rise" style="--i:3">
    <PayrollWindow />
  </div>
</div>
