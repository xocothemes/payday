---
import CtaButton from "@/components/ui/CtaButton.astro";
import Icon from "@/components/ui/Icon.astro";
import Wordmark from "@/components/ui/Wordmark.astro";
import { navigation, siteConfig } from "@/config/site";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const { cta, signIn } = siteConfig;
const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes("#") && href !== "/" && path.startsWith(href);
---

<header class="site-header fixed inset-x-0 top-0 z-50" data-header data-overlay={overlay ? "" : undefined}>
  <div class="header-bar relative z-20">
    <div class="shell-wide relative flex h-(--header-h) items-center gap-4">
      <a href="/" class="flex shrink-0" aria-label={`${siteConfig.name} home`} data-logo-menu-trigger>
        <Wordmark class="h-7" />
      </a>

      <nav class="absolute left-1/2 hidden -translate-x-1/2 lg:block" aria-label="Main">
        <ul class="flex items-center gap-1">
          {
            navigation.map((item) => (
              <li>
                <a href={item.href} class="nav-link" aria-current={isCurrent(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="ml-auto flex items-center gap-1 sm:gap-2">
        <a href={signIn.href} class="nav-link hidden md:inline-flex">{signIn.label}</a>
        <CtaButton href={cta.href} label={cta.label} size="sm" class="header-cta hidden sm:inline-flex" />
        <button
          type="button"
          class="-mr-2 grid size-11 place-items-center rounded-full transition-colors hover:bg-ink/5 lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Open menu"
          data-mobile-toggle
        >
          <span class="grid" data-icon-open><Icon name="menu" class="size-5" /></span>
          <span class="hidden" data-icon-close><Icon name="x" class="size-5" /></span>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-nav fixed inset-0 z-10 overflow-y-auto bg-page lg:hidden" inert data-mobile-nav>
    <nav class="shell flex min-h-full flex-col pt-[calc(var(--header-h)+1rem)] pb-8" aria-label="Mobile">
      <ul class="grid gap-1">
        {
          navigation.map((item) => (
            <li>
              <a href={item.href} class="block py-2.5 text-3xl tracking-[-0.04em]" data-menu-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-auto grid gap-3 pt-10">
        <CtaButton href={cta.href} label={cta.label} class="w-full justify-between" />
        <a href={signIn.href} class="py-2 text-center text-muted">{signIn.label}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    transition: transform 0.45s var(--ease-out-expo);
  }

  .site-header[data-hidden] {
    transform: translateY(-110%);
  }

  .header-bar {
    background: var(--page);
    transition:
      background-color 0.3s,
      color 0.3s,
      box-shadow 0.3s;
  }

  /* Over the hero: transparent with light text until the page scrolls. */
  [data-overlay]:not([data-scrolled], [data-mobile-open]) .header-bar {
    background: transparent;
    color: #fff;
  }

  [data-overlay]:not([data-scrolled], [data-mobile-open]) .nav-link {
    color: rgb(255 255 255 / 0.82);
  }

  [data-overlay]:not([data-scrolled], [data-mobile-open]) .nav-link:hover,
  [data-overlay]:not([data-scrolled], [data-mobile-open]) .nav-link[aria-current="page"] {
    color: #fff;
    background: rgb(255 255 255 / 0.12);
  }

  [data-overlay]:not([data-scrolled], [data-mobile-open]) .header-cta {
    background: #fff;
    color: var(--ink);
  }

  [data-overlay]:not([data-scrolled], [data-mobile-open]) .header-cta :global(.btn-cta-icon) {
    background: var(--ink);
    color: #fff;
  }

  [data-scrolled] .header-bar {
    box-shadow: 0 1px 0 var(--line);
  }

  [data-mobile-open] .header-bar {
    box-shadow: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--ink);
    background: var(--wash);
  }

  .mobile-nav {
    overscroll-behavior: contain;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s;
  }

  [data-mobile-open] .mobile-nav {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");

  if (header) {
    const toggle = header.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
    const sheet = header.querySelector<HTMLElement>("[data-mobile-nav]");

    const setMobile = (open: boolean) => {
      header.toggleAttribute("data-mobile-open", open);
      if (sheet) sheet.inert = !open;
      toggle?.setAttribute("aria-expanded", String(open));
      toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      toggle?.querySelector("[data-icon-open]")?.classList.toggle("hidden", open);
      toggle?.querySelector("[data-icon-close]")?.classList.toggle("hidden", !open);
      document.documentElement.style.overflow = open ? "hidden" : "";
    };

    toggle?.addEventListener("click", () => setMobile(!header.hasAttribute("data-mobile-open")));
    header.querySelectorAll("[data-menu-link]").forEach((link) => link.addEventListener("click", () => setMobile(false)));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && header.hasAttribute("data-mobile-open")) {
        setMobile(false);
        toggle?.focus();
      }
    });

    window.matchMedia("(min-width: 64rem)").addEventListener("change", (event) => {
      if (event.matches) setMobile(false);
    });

    /* Hide while scrolling down, return on any scroll up. Never hides near the top or with the menu open. */
    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      const busy = header.hasAttribute("data-mobile-open") || header.contains(document.activeElement);
      header.toggleAttribute("data-scrolled", y > 8);
      if (y < 120 || busy) header.removeAttribute("data-hidden");
      else if (Math.abs(y - lastY) > 6) header.toggleAttribute("data-hidden", y > lastY);
      lastY = y;
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    header.addEventListener("focusin", () => header.removeAttribute("data-hidden"));
  }
</script>
