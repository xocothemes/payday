---
import Icon from "@/components/ui/Icon.astro";
import Wordmark from "@/components/ui/Wordmark.astro";
import { footerNavigation, siteConfig } from "@/config/site";
import { socialIcon } from "@/lib/socials";

const year = new Date().getFullYear();
---

<footer class="on-night">
  <div class="shell-wide flex flex-col gap-8 py-12 md:flex-row md:items-center md:gap-12">
    <a href="/" class="inline-flex self-start md:self-auto" aria-label={`${siteConfig.name} home`} data-logo-menu-trigger>
      <Wordmark class="h-6" />
    </a>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-7 gap-y-2 text-sm">
        {
          footerNavigation.map((link) => (
            <li>
              <a href={link.href} class="text-night-muted transition-colors hover:text-night-ink">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="flex items-center gap-4 text-sm text-night-muted md:ml-auto">
      <ul class="-ml-2 flex items-center">
        {
          siteConfig.socials.map((social) => (
            <li>
              <a href={social.href} class="grid size-9 place-items-center rounded-full transition-colors hover:text-night-ink" aria-label={social.label}>
                <Icon name={socialIcon(social.label)} class="size-4" />
              </a>
            </li>
          ))
        }
      </ul>
      <p>© {year} {siteConfig.name}</p>
    </div>
  </div>
</footer>
