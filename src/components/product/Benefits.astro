---
import Icon from "@/components/ui/Icon.astro";

const plans = [
  { name: "Health", detail: "Gold plan · family", cost: "$412", on: true },
  { name: "Pension", detail: "5% matched", cost: "$310", on: true },
  { name: "Wellbeing", detail: "Gym and therapy", cost: "$60" },
];
---

<div class="grid w-full max-w-sm gap-2.5" aria-hidden="true">
  {
    plans.map((plan) => (
      <div class:list={["flex items-center gap-3 rounded-xl bg-surface p-4 ring-inset", plan.on ? "ring-[1.5px] ring-ink" : "ring-1 ring-line"]}>
        <span class:list={["grid size-5 place-items-center rounded-md", plan.on ? "bg-ink text-white" : "ring-1 ring-line-strong ring-inset"]}>
          {plan.on && <Icon name="check" class="size-3" stroke={3} />}
        </span>
        <span class="min-w-0 flex-1 text-[0.8125rem] leading-tight">
          <span class="block font-medium">{plan.name}</span>
          <span class="block text-muted">{plan.detail}</span>
        </span>
        <span class="text-[0.8125rem] tabular">
          {plan.cost}
          <span class="text-muted">/mo</span>
        </span>
      </div>
    ))
  }
  <p class="mt-1 flex justify-between px-1 text-[0.8125rem]">
    <span class="text-muted">Deducted on each payslip</span>
    <span class="tabular">$722</span>
  </p>
</div>
