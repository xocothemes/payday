---
const lines = [
  { label: "Regular hours", value: "$142,600.00" },
  { label: "Overtime", value: "$8,214.50" },
  { label: "Bonuses", value: "$12,000.00" },
  { label: "Employer taxes", value: "$21,505.92" },
];
---

<div class="w-full max-w-sm rounded-2xl bg-surface p-5 ring-1 ring-line" aria-hidden="true">
  <div class="flex items-center justify-between text-sm">
    <span class="font-medium">Pay run</span>
    <span class="mono-label rounded bg-wash px-2 py-1 text-muted">NOV 1 – 15</span>
  </div>
  <dl class="mt-4 grid gap-2.5 text-[0.8125rem]">
    {
      lines.map((line) => (
        <div class="flex justify-between">
          <dt class="text-ink-soft">{line.label}</dt>
          <dd class="tabular">{line.value}</dd>
        </div>
      ))
    }
  </dl>
  <div class="mt-4 flex items-baseline justify-between border-t border-line pt-4">
    <span class="text-sm text-muted">Total</span>
    <span class="text-2xl tracking-[-0.04em] tabular">$184,320.42</span>
  </div>
  <span class="mt-5 grid h-10 place-items-center rounded-xl bg-ink text-sm font-medium text-white">Submit payroll</span>
</div>
