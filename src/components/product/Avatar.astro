---
interface Props {
  name: string;
  class?: string;
}

const tones = [
  "bg-[#e8e3fb] text-[#4b3db0]",
  "bg-[#fde7dc] text-[#a3461b]",
  "bg-[#dff1e7] text-[#1f6e43]",
  "bg-[#dcebfb] text-[#1d5ea8]",
  "bg-[#fbe3ee] text-[#a32e66]",
  "bg-[#f6eccd] text-[#80600b]",
];

const { name, class: className = "size-7 text-[0.625rem]" } = Astro.props;
const initials = name
  .split(" ")
  .map((part) => part[0])
  .join("")
  .slice(0, 2);
const tone = tones[[...name].reduce((sum, ch) => sum + ch.charCodeAt(0), 0) % tones.length];
---

<span class:list={["grid shrink-0 place-items-center rounded-full font-semibold", tone, className]} aria-hidden="true">{initials}</span>
