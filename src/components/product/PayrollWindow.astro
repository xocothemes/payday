---
import Avatar from "@/components/product/Avatar.astro";
import Icon from "@/components/ui/Icon.astro";
import Logomark from "@/components/ui/Logomark.astro";

const nav = [
  { icon: "users", label: "People" },
  { icon: "banknote", label: "Payroll", active: true },
  { icon: "calendar-check", label: "Time off" },
  { icon: "heart", label: "Benefits" },
  { icon: "landmark", label: "Taxes" },
  { icon: "chart-column", label: "Reports" },
];

const summary = [
  { label: "Total cost", value: "$184,320.42" },
  { label: "People", value: "42 + 6 contractors" },
  { label: "Debit date", value: "Nov 13" },
];

const people = [
  { name: "Ingrid Solberg", role: "Design lead", country: "NO", pay: "kr 58,400" },
  { name: "Tomás Herrera", role: "Engineer", country: "PT", pay: "€4,120" },
  { name: "Thandiwe Nkosi", role: "Account manager", country: "ZA", pay: "R 61,250" },
  { name: "Ayumi Sato", role: "Product manager", country: "JP", pay: "¥612,400" },
  { name: "Dana Whitfield", role: "Head of sales", country: "US", pay: "$7,850" },
];

const steps = ["Hours", "Review", "Submit"];
---

<div class="relative" aria-hidden="true">
  <div class="overflow-hidden rounded-[1.25rem] border border-line bg-surface text-left">
    <div class="flex">
      <div class="hidden w-48 shrink-0 border-r border-line p-3 md:block">
        <div class="flex items-center gap-2.5 px-2 py-1.5">
          <Logomark class="size-5" />
          <span class="text-sm font-medium">Meridian</span>
        </div>
        <ul class="mt-5 grid gap-0.5 text-[0.8125rem]">
          {
            nav.map((item) => (
              <li class:list={["flex items-center gap-2.5 rounded-lg px-2 py-1.5", item.active ? "bg-wash font-medium" : "text-ink-soft"]}>
                <Icon name={item.icon} class="size-4" />
                {item.label}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="min-w-0 flex-1 p-5 sm:p-7">
        <div class="flex flex-wrap items-center gap-3">
          <div>
            <p class="text-lg tracking-[-0.03em]">Payroll</p>
            <p class="text-[0.8125rem] text-muted">Nov 1 – 15, 2026</p>
          </div>
          <ol class="mx-auto hidden items-center gap-2 text-[0.8125rem] lg:flex">
            {
              steps.map((step, index) => (
                <li class="flex items-center gap-2">
                  {index > 0 && <span class="h-px w-6 bg-line-strong" />}
                  <span class:list={["grid size-5 place-items-center rounded-full text-[0.625rem] font-semibold", index === 0 ? "bg-up text-white" : index === 1 ? "bg-ink text-white" : "ring-1 ring-line-strong text-muted ring-inset"]}>
                    {index === 0 ? <Icon name="check" class="size-3" stroke={3} /> : index + 1}
                  </span>
                  <span class:list={[index === 2 && "text-muted"]}>{step}</span>
                </li>
              ))
            }
          </ol>
          <span class="ml-auto rounded-full bg-ink px-3.5 py-2 text-[0.8125rem] font-medium text-white lg:ml-0">Submit payroll</span>
        </div>

        <dl class="mt-6 grid grid-cols-3 divide-x divide-line rounded-xl border border-line">
          {
            summary.map((item) => (
              <div class="flex flex-col-reverse px-4 py-3">
                <dt class="text-[0.75rem] text-muted">{item.label}</dt>
                <dd class="truncate text-[0.9375rem] font-medium tabular sm:text-base">{item.value}</dd>
              </div>
            ))
          }
        </dl>

        <ul class="mt-5 divide-y divide-line">
          {
            people.map((person) => (
              <li class="flex items-center gap-3 py-3">
                <Avatar name={person.name} class="size-8 text-[0.625rem]" />
                <span class="min-w-0 flex-1 text-[0.8125rem] leading-tight">
                  <span class="block truncate font-medium">{person.name}</span>
                  <span class="block truncate text-muted">{person.role}</span>
                </span>
                <span class="mono-label hidden rounded bg-wash px-1.5 py-0.5 text-muted sm:inline">{person.country}</span>
                <span class="w-24 text-right text-[0.8125rem] tabular">{person.pay}</span>
                <span class="hidden items-center gap-1 text-[0.75rem] text-up sm:inline-flex">
                  <span class="size-1.5 rounded-full bg-up" />
                  Ready
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="float-card absolute -top-6 -right-6 hidden w-60 rounded-2xl bg-surface p-4 ring-1 ring-line lg:block">
    <p class="flex items-center gap-2 text-[0.8125rem] font-medium">
      <span class="grid size-5 place-items-center rounded-full bg-up text-white"><Icon name="check" class="size-3" stroke={3} /></span>
      Paid on time
    </p>
    <p class="mt-2 text-2xl tracking-[-0.04em] tabular">¥612,400</p>
    <p class="text-[0.75rem] text-muted">Ayumi Sato · Tokyo</p>
  </div>

  <div class="float-card absolute -bottom-10 -left-6 hidden w-64 rounded-2xl bg-surface p-4 ring-1 ring-line lg:block" style="--d:1">
    <p class="text-[0.8125rem] font-medium">Taxes filed</p>
    <ul class="mt-2.5 grid gap-2 text-[0.75rem]">
      {
        ["Form 941 · US", "PAYE · Norway", "EMP201 · South Africa"].map((filing) => (
          <li class="flex items-center gap-2">
            <Icon name="circle-check" class="size-3.5 text-up" stroke={2} />
            {filing}
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .float-card {
    animation: float-in 1s var(--ease-out-expo) calc(0.9s + var(--d, 0) * 0.25s) both;
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.97);
    }
  }
</style>
