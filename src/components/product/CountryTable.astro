---
const rows = [
  { country: "United States", code: "US", people: 18, currency: "USD", amount: "$96,410", payday: "Nov 14", paid: true },
  { country: "Norway", code: "NO", people: 6, currency: "NOK", amount: "kr 341,200", payday: "Nov 14", paid: true },
  { country: "Portugal", code: "PT", people: 9, currency: "EUR", amount: "€37,850", payday: "Nov 14", paid: true },
  { country: "South Africa", code: "ZA", people: 5, currency: "ZAR", amount: "R 298,640", payday: "Nov 15" },
  { country: "Japan", code: "JP", people: 4, currency: "JPY", amount: "¥2,418,900", payday: "Nov 15" },
];
---

<div class="overflow-x-auto" aria-hidden="true">
  <table class="w-full min-w-[34rem] text-left text-[0.8125rem]">
    <thead class="mono-label text-muted">
      <tr class="border-b border-line">
        <th class="py-2.5 font-normal">COUNTRY</th>
        <th class="py-2.5 font-normal">PEOPLE</th>
        <th class="py-2.5 font-normal">GROSS PAY</th>
        <th class="py-2.5 font-normal">PAYDAY</th>
        <th class="py-2.5 text-right font-normal">STATUS</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-line">
      {
        rows.map((row) => (
          <tr>
            <td class="py-3">
              <span class="flex items-center gap-2.5">
                <span class="mono-label rounded bg-wash px-1.5 py-0.5 text-ink-soft">{row.code}</span>
                {row.country}
              </span>
            </td>
            <td class="py-3 tabular">{row.people}</td>
            <td class="py-3 tabular">
              {row.amount} <span class="text-muted">{row.currency}</span>
            </td>
            <td class="py-3">{row.payday}</td>
            <td class="py-3 text-right">
              <span class:list={["rounded-full px-2 py-1 text-[0.6875rem] font-medium", row.paid ? "bg-up-soft text-up" : "bg-accent-soft text-accent"]}>
                {row.paid ? "Paid" : "Scheduled"}
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
