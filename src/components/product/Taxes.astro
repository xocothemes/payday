---
import Icon from "@/components/ui/Icon.astro";

const filings = [
  { form: "Form 941", place: "United States", due: "Filed Oct 31", done: true },
  { form: "PAYE", place: "Norway", due: "Filed Nov 5", done: true },
  { form: "EMP201", place: "South Africa", due: "Filed Nov 7", done: true },
  { form: "DMR", place: "Portugal", due: "Due Nov 10" },
];
---

<div class="w-full max-w-sm rounded-2xl bg-surface p-2 ring-1 ring-line" aria-hidden="true">
  <ul class="divide-y divide-line">
    {
      filings.map((filing) => (
        <li class="flex items-center gap-3 px-3 py-3.5">
          <span class="grid size-8 place-items-center rounded-lg bg-wash">
            <Icon name="landmark" class="size-4 text-ink-soft" />
          </span>
          <span class="min-w-0 flex-1 text-[0.8125rem] leading-tight">
            <span class="block font-medium">{filing.form}</span>
            <span class="block text-muted">{filing.place}</span>
          </span>
          <span class:list={["inline-flex items-center gap-1 rounded-full px-2 py-1 text-[0.6875rem] font-medium", filing.done ? "bg-up-soft text-up" : "bg-warn-soft text-warn"]}>
            {filing.done && <Icon name="check" class="size-3" stroke={2.5} />}
            {filing.due}
          </span>
        </li>
      ))
    }
  </ul>
</div>
