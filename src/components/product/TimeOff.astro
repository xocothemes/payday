---
import Avatar from "@/components/product/Avatar.astro";

const days = ["M", "T", "W", "T", "F"];
/* Which weekdays each person is off, in a two-week view. */
const people = [
  { name: "Lars Eriksen", off: [2, 3, 4] },
  { name: "Noor Haddad", off: [7] },
  { name: "Tomás Herrera", off: [5, 6, 7, 8, 9] },
];
---

<div class="w-full max-w-sm rounded-2xl bg-surface p-5 ring-1 ring-line" aria-hidden="true">
  <div class="flex items-center justify-between text-sm">
    <span class="font-medium">Time off</span>
    <span class="text-[0.8125rem] text-muted">Nov 9 – 20</span>
  </div>
  <div class="mono-label mt-4 grid grid-cols-[6.5rem_repeat(10,1fr)] gap-1 text-center text-muted">
    <span></span>
    {[...days, ...days].map((day) => <span>{day}</span>)}
  </div>
  <ul class="mt-2 grid gap-2">
    {
      people.map((person) => (
        <li class="grid grid-cols-[6.5rem_repeat(10,1fr)] items-center gap-1">
          <span class="flex items-center gap-2 text-[0.75rem]">
            <Avatar name={person.name} class="size-5 text-[0.5rem]" />
            {person.name.split(" ")[0]}
          </span>
          {Array.from({ length: 10 }, (_, i) => (
            <span class:list={["h-6 rounded", person.off.includes(i) ? "bg-accent/80" : "bg-wash"]} />
          ))}
        </li>
      ))
    }
  </ul>
  <div class="mt-5 flex items-center gap-3 rounded-xl bg-wash p-3 text-[0.8125rem]">
    <Avatar name="Tomás Herrera" class="size-7 text-[0.5625rem]" />
    <span class="min-w-0 flex-1 leading-tight">
      <span class="block font-medium">Tomás · 5 days</span>
      <span class="block text-muted">Holiday, Nov 16 – 20</span>
    </span>
    <span class="rounded-full bg-ink px-3 py-1.5 text-[0.75rem] font-medium text-white">Approve</span>
  </div>
</div>
