---
import CtaButton from "@/components/ui/CtaButton.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The page you were looking for does not exist or has moved." noindex overlay>
  <section class="dusk grain relative isolate grid min-h-svh content-center justify-items-center overflow-hidden px-(--gutter) py-32 text-center">
    <p class="rise mono-label relative z-10 text-white/70">404</p>
    <h1 class="rise relative z-10 mt-4 text-display-xl" style="--i:1">Lost in space</h1>
    <CtaButton href="/" label="Back home" tone="light" class="rise relative z-10 mt-9" style="--i:2" />
  </section>
</BaseLayout>
