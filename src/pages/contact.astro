---
import Icon from "@/components/ui/Icon.astro";
import PageHero from "@/components/ui/PageHero.astro";
import { contact } from "@/config/contact";
import { siteConfig } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const live = siteConfig.contact.enabled && siteConfig.contact.action.trim() !== "";
const fieldClass =
  "h-11 w-full min-w-0 rounded-lg bg-surface px-3.5 shadow-[inset_0_0_0_1px_var(--line-strong)] outline-none transition-shadow placeholder:text-muted focus-visible:shadow-[inset_0_0_0_1.5px_var(--ink),0_0_0_4px_var(--accent-soft)] focus-visible:outline-none";
---

<BaseLayout title="Contact" description={contact.lead} overlay>
  <PageHero title={contact.title} lead={contact.lead} overlap />

  <section class="shell relative z-10 -mt-[clamp(6rem,14vw,11rem)] pb-20 lg:pb-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="rise lg:order-2 lg:col-span-7" style="--i:2">
        <form
          class="grid gap-6 rounded-(--radius-card) border border-line bg-surface p-6 sm:p-9"
          action={live ? siteConfig.contact.action : undefined}
          method={siteConfig.contact.method}
          aria-describedby={live ? undefined : "contact-note"}
        >
          <p class="text-title">
            <label for="contact-topic">I’d like to</label>
            <span class="topic relative ml-1 inline-flex items-center">
              <select
                id="contact-topic"
                name="topic"
                class="topic-select appearance-none rounded-md bg-accent-soft py-0.5 pr-8 pl-2.5 outline-none focus-visible:outline-2 focus-visible:outline-ink"
                data-contact-topic
              >
                {contact.topics.map((topic) => <option value={topic.value}>{topic.label}</option>)}
              </select>
              <Icon name="chevron-down" class="pointer-events-none absolute right-2 size-4.5" stroke={2} />
            </span>
          </p>

          <div class="grid gap-5 sm:grid-cols-2">
            <div class="grid gap-2">
              <label for="contact-name" class="text-sm font-medium">Name</label>
              <input id="contact-name" name="name" type="text" autocomplete="name" required class={fieldClass} />
            </div>
            <div class="grid gap-2">
              <label for="contact-email" class="text-sm font-medium">Work email</label>
              <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="you@company.com" required class={fieldClass} />
            </div>
            <div class="grid gap-2">
              <label for="contact-company" class="text-sm font-medium">Company</label>
              <input id="contact-company" name="company" type="text" autocomplete="organization" class={fieldClass} />
            </div>
            <div class="grid gap-2">
              <label for="contact-size" class="text-sm font-medium">Company size</label>
              <div class="relative">
                <select id="contact-size" name="company_size" class:list={[fieldClass, "appearance-none pr-10"]}>
                  <option value="">Choose one</option>
                  {contact.teamSizes.map((size) => <option>{size}</option>)}
                </select>
                <Icon name="chevron-down" class="pointer-events-none absolute top-1/2 right-3.5 size-4 -translate-y-1/2 text-muted" />
              </div>
            </div>
          </div>

          <div class="grid gap-2">
            <label for="contact-message" class="text-sm font-medium">{contact.messageLabel}</label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder={contact.messagePlaceholder}
              class:list={[fieldClass, "h-auto resize-y py-3"]}></textarea>
          </div>

          <div class="grid gap-3">
            <button type="submit" class="btn btn-primary justify-self-start disabled:cursor-not-allowed disabled:opacity-60" disabled={!live}>
              Send message
              <Icon name="arrow-right" class="size-4" stroke={2} />
            </button>
            {
              !live && (
                <p id="contact-note" class="text-sm text-muted">
                  The form is off in this preview. Connect a form endpoint in the site config to turn it on.
                </p>
              )
            }
          </div>
        </form>
      </div>

      <div class="lg:order-1 lg:col-span-5 lg:pt-[clamp(8rem,16vw,13rem)]">
        <h2 class="reveal text-sm text-muted">{contact.routesTitle}</h2>
        <dl class="reveal mt-4 grid overflow-hidden rounded-(--radius-card) border border-line sm:grid-cols-2">
          {
            contact.routes.map((route, index) => (
              <div
                class:list={[
                  "border-line p-4",
                  index < contact.routes.length - 1 && "border-b",
                  index % 2 === 0 && "sm:border-r",
                  index >= contact.routes.length - 2 && "sm:border-b-0",
                ]}
              >
                <dt class="text-sm font-medium">{route.label}</dt>
                <dd class="mt-1 truncate text-sm">
                  <a href={`mailto:${route.email}`} class="link text-muted">
                    {route.email}
                  </a>
                </dd>
              </div>
            ))
          }
        </dl>

        <h2 class="reveal mt-12 text-sm text-muted">{contact.officesTitle}</h2>
        <ul class="reveal mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-1">
          {
            contact.offices.map((office) => (
              <li class="flex gap-3">
                <Icon name="map-pin" class="mt-0.5 size-4 text-muted" />
                <span>
                  <span class="block text-sm font-medium">{office.city}</span>
                  <address class="text-sm text-muted not-italic">
                    {office.address.map((line) => (
                      <span class="block">{line}</span>
                    ))}
                  </address>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .topic-select {
    field-sizing: content;
    max-width: 100%;
    cursor: pointer;
  }

  .topic-select option {
    color: var(--ink);
    font-size: 1rem;
  }
</style>

<script>
  const topic = new URLSearchParams(window.location.search).get("topic");
  const select = document.querySelector<HTMLSelectElement>("[data-contact-topic]");
  if (select && topic && [...select.options].some((option) => option.value === topic)) select.value = topic;
</script>
