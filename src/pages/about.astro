---
import { Image } from "astro:assets";
import Closing from "@/components/home/Closing.astro";
import Icon from "@/components/ui/Icon.astro";
import PageHero from "@/components/ui/PageHero.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { about } from "@/config/about";
import BaseLayout from "@/layouts/BaseLayout.astro";

const { story, facts, principles, milestones, team } = about;
---

<BaseLayout title="About" description={about.lead} image={about.photo} imageAlt={about.photoAlt} overlay>
  <PageHero title={about.title} lead={about.lead} overlap />

  <div class="shell relative z-10 -mt-[clamp(6rem,14vw,11rem)]">
    <Image
      src={about.photo}
      alt={about.photoAlt}
      widths={[800, 1200, 1600, 2000]}
      sizes="(min-width: 76rem) 1120px, 100vw"
      loading="eager"
      class="rise aspect-video w-full rounded-(--radius-card) border border-line object-cover"
      style="--i:2"
    />
  </div>

  <section class="shell section grid gap-10 md:grid-cols-[1fr_1.4fr] md:gap-16" aria-labelledby="story-title">
    <SectionTitle id="story-title" title={story.title} subtitle={story.subtitle} />
    <div class="reveal grid gap-5 text-lead text-ink-soft">
      {story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="shell" aria-label="Facts">
    <dl class="grid grid-cols-2 overflow-hidden rounded-(--radius-card) border border-line lg:grid-cols-4">
      {
        facts.map((fact, index) => (
          <div
            class:list={[
              "reveal flex flex-col-reverse justify-end border-line p-6 sm:p-8",
              index % 2 === 0 && "border-r",
              index < 2 && "border-b lg:border-b-0",
              index === 1 && "lg:border-r",
            ]}
            style={`--i:${index}`}
          >
            <dt class="mt-3 text-sm text-ink-soft">{fact.label}</dt>
            <dd class="text-[clamp(1.9rem,1.4rem+2vw,3.25rem)] leading-none tracking-[-0.06em] tabular">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="shell section" aria-labelledby="principles-title">
    <SectionTitle id="principles-title" title={principles.title} subtitle={principles.subtitle} />
    <ul class="mt-12 grid overflow-hidden rounded-(--radius-card) border border-line md:grid-cols-3">
      {
        principles.items.map((item, index) => (
          <li
            class:list={["reveal border-line p-6 sm:p-8", index < principles.items.length - 1 && "border-b md:border-b-0 md:border-r"]}
            style={`--i:${index}`}
          >
            <span class="grid size-10 place-items-center rounded-xl bg-wash">
              <Icon name={item.icon} class="size-5" stroke={1.5} />
            </span>
            <h3 class="mt-6 font-medium tracking-[-0.02em]">{item.title}</h3>
            <p class="mt-1.5 text-[0.9375rem] text-muted">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="shell pb-20 sm:pb-28" aria-labelledby="milestones-title">
    <SectionTitle id="milestones-title" title={milestones.title} />
    <ol class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        milestones.items.map((item, index) => (
          <li class="reveal border-t border-line pt-6" style={`--i:${index}`}>
            <p class="mono-label text-muted">{item.year}</p>
            <h3 class="mt-3 font-medium tracking-[-0.02em]">{item.title}</h3>
            <p class="mt-1.5 text-[0.9375rem] text-muted">{item.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="shell pb-20 sm:pb-28" aria-labelledby="team-title">
    <SectionTitle id="team-title" title={team.title} />
    <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 lg:grid-cols-4 lg:gap-x-6">
      {
        team.people.map((person, index) => (
          <li class="reveal" style={`--i:${index}`}>
            <Image
              src={person.photo}
              alt={`Portrait of ${person.name}`}
              widths={[240, 360, 480]}
              sizes="(min-width: 64rem) 17rem, 45vw"
              class="aspect-4/5 w-full rounded-xl border border-line object-cover object-top"
            />
            <h3 class="mt-4 text-[0.9375rem] font-medium">{person.name}</h3>
            <p class="text-sm text-muted">{person.role}</p>
          </li>
        ))
      }
    </ul>
  </section>


  <Closing />
</BaseLayout>
